<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Версия для людей — в version.txt. CI передаёт -p:Version=X.Y.Z-dev.<run>. -->
  <PropertyGroup>
    <GigaRestVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</GigaRestVersion>
    <Version Condition="'$(Version)' == ''">$(GigaRestVersion)</Version>
    <Product>GigaRest</Product>
    <Company>Luchano55</Company>
    <Copyright>© 2026 Luchano55, MIT License</Copyright>
  </PropertyGroup>
</Project>
